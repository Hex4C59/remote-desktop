        <!-- 两端 transport 之间：局域网直连 -->
        <mxCell id="lan-link" value="" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=0;strokeColor=#dc2626;strokeWidth=2.5;edgeStyle=none;rounded=0;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="798" y="303" as="sourcePoint"/>
