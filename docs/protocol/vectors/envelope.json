{
  "protocol_version": 1,
  "note": "虚构凭据，只用于信封与控制消息编解码。公钥为 SPKI 占位值。每条向量独立，不能用来验证握手或消息顺序。",
  "vectors": [
    {
      "name": "质询（会话尚未建立）",
      "direction": "server->client",
      "input": "{\"v\":1,\"type\":\"session.challenge\",\"session\":null,\"negotiation\":null,\"seq\":1,\"payload\":{\"challenge_id\":\"2b0f0f3e-0000-4000-8000-000000000001\",\"expires_in_ms\":30000}}",
      "expect": {"ok": true, "type": "session.challenge", "session": null, "negotiation": null, "seq": 1}
    },
    {
      "name": "配对请求",
      "direction": "client->server",
      "input": "{\"v\":1,\"type\":\"pair.request\",\"session\":null,\"negotiation\":null,\"seq\":1,\"payload\":{\"device_id\":\"2b0f0f3e-0000-4000-8000-000000000002\",\"public_key\":\"MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMw\"}}",
      "expect": {"ok": true, "type": "pair.request", "session": null, "negotiation": null, "seq": 1}
    },
    {
      "name": "配对受理",
      "direction": "server->client",
      "input": "{\"v\":1,\"type\":\"pair.accept\",\"session\":null,\"negotiation\":null,\"seq\":1,\"payload\":{\"device_id\":\"2b0f0f3e-0000-4000-8000-000000000003\",\"public_key\":\"MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMw\"}}",
      "expect": {"ok": true, "type": "pair.accept", "session": null, "negotiation": null, "seq": 1}
    },
    {
      "name": "被控端现场确认",
      "direction": "server->client",
      "input": "{\"v\":1,\"type\":\"pair.confirm\",\"session\":null,\"negotiation\":null,\"seq\":2,\"payload\":{}}",
      "expect": {"ok": true, "type": "pair.confirm", "session": null, "negotiation": null, "seq": 2}
    },
    {
      "name": "控制端已暂存配对身份",
      "direction": "client->server",
      "input": "{\"v\":1,\"type\":\"pair.ready\",\"session\":null,\"negotiation\":null,\"seq\":2,\"payload\":{}}",
      "expect": {"ok": true, "type": "pair.ready", "session": null, "negotiation": null, "seq": 2}
    },
    {
      "name": "被控端已提交配对身份",
      "direction": "server->client",
      "input": "{\"v\":1,\"type\":\"pair.complete\",\"session\":null,\"negotiation\":null,\"seq\":3,\"payload\":{}}",
      "expect": {"ok": true, "type": "pair.complete", "session": null, "negotiation": null, "seq": 3}
    },
    {
      "name": "配对拒绝（短码不一致）",
      "direction": "both",
      "input": "{\"v\":1,\"type\":\"pair.reject\",\"session\":null,\"negotiation\":null,\"seq\":3,\"payload\":{\"reason\":\"code_mismatch\"}}",
      "expect": {"ok": true, "type": "pair.reject", "session": null, "negotiation": null, "seq": 3}
    },
    {
      "name": "会话请求（连接已认证）",
      "direction": "client->server",
      "input": "{\"v\":1,\"type\":\"session.request\",\"session\":null,\"negotiation\":null,\"seq\":1,\"payload\":{\"challenge_id\":\"2b0f0f3e-0000-4000-8000-000000000001\",\"permissions\":[\"view\",\"mouse\",\"keyboard\"]}}",
      "expect": {"ok": true, "type": "session.request", "session": null, "negotiation": null, "seq": 1}
    },
    {
      "name": "会话拒绝（质询无效或已过期）",
      "direction": "server->client",
      "input": "{\"v\":1,\"type\":\"session.reject\",\"session\":null,\"negotiation\":null,\"seq\":2,\"payload\":{\"reason\":\"expired\"}}",
      "expect": {"ok": true, "type": "session.reject", "session": null, "negotiation": null, "seq": 2}
    },
    {
      "name": "会话受理（本机已批准）",
      "direction": "server->client",
      "input": "{\"v\":1,\"type\":\"session.accept\",\"session\":\"7f1a5c8e-0000-4000-8000-000000000001\",\"negotiation\":null,\"seq\":1,\"payload\":{\"permissions\":[\"view\",\"mouse\",\"keyboard\"]}}",
      "expect": {"ok": true, "type": "session.accept", "session": "7f1a5c8e-0000-4000-8000-000000000001", "negotiation": null, "seq": 1}
    },
    {
      "name": "媒体参数协商（代次 1）",
      "direction": "server->client",
      "input": "{\"v\":1,\"type\":\"media.offer\",\"session\":\"7f1a5c8e-0000-4000-8000-000000000001\",\"negotiation\":1,\"seq\":2,\"payload\":{\"codec\":\"h264-baseline\",\"width\":1280,\"height\":720,\"max_fps\":30,\"max_bitrate_bps\":4000000,\"keyframe_interval_frames\":60,\"display_map_version\":1}}",
      "expect": {"ok": true, "type": "media.offer", "session": "7f1a5c8e-0000-4000-8000-000000000001", "negotiation": 1, "seq": 2}
    },
    {
      "name": "媒体接受，回显同一代次",
      "direction": "client->server",
      "input": "{\"v\":1,\"type\":\"media.answer\",\"session\":\"7f1a5c8e-0000-4000-8000-000000000001\",\"negotiation\":1,\"seq\":1,\"payload\":{\"accept\":true}}",
      "expect": {"ok": true, "type": "media.answer", "session": "7f1a5c8e-0000-4000-8000-000000000001", "negotiation": 1, "seq": 1}
    },
    {
      "name": "媒体拒绝（不支持编解码）",
      "direction": "client->server",
      "input": "{\"v\":1,\"type\":\"media.answer\",\"session\":\"7f1a5c8e-0000-4000-8000-000000000001\",\"negotiation\":1,\"seq\":1,\"payload\":{\"accept\":false,\"reason\":\"unsupported_codec\"}}",
      "expect": {"ok": true, "type": "media.answer", "session": "7f1a5c8e-0000-4000-8000-000000000001", "negotiation": 1, "seq": 1}
    },
    {
      "name": "首帧就绪",
      "direction": "client->server",
      "input": "{\"v\":1,\"type\":\"session.ready\",\"session\":\"7f1a5c8e-0000-4000-8000-000000000001\",\"negotiation\":1,\"seq\":2,\"payload\":{}}",
      "expect": {"ok": true, "type": "session.ready", "session": "7f1a5c8e-0000-4000-8000-000000000001", "negotiation": 1, "seq": 2}
    },
    {
      "name": "被控端发布输入代次",
      "direction": "server->client",
      "input": "{\"v\":1,\"type\":\"input.prepare\",\"session\":\"7f1a5c8e-0000-4000-8000-000000000001\",\"negotiation\":null,\"seq\":3,\"payload\":{\"input_epoch\":1}}",
      "expect": {"ok": true, "type": "input.prepare", "session": "7f1a5c8e-0000-4000-8000-000000000001", "negotiation": null, "seq": 3}
    },
    {
      "name": "控制端确认输入代次",
      "direction": "client->server",
      "input": "{\"v\":1,\"type\":\"input.ready\",\"session\":\"7f1a5c8e-0000-4000-8000-000000000001\",\"negotiation\":null,\"seq\":3,\"payload\":{\"input_epoch\":1}}",
      "expect": {"ok": true, "type": "input.ready", "session": "7f1a5c8e-0000-4000-8000-000000000001", "negotiation": null, "seq": 3}
    },
    {
      "name": "被控端已启用输入门禁",
      "direction": "server->client",
      "input": "{\"v\":1,\"type\":\"input.enabled\",\"session\":\"7f1a5c8e-0000-4000-8000-000000000001\",\"negotiation\":null,\"seq\":4,\"payload\":{\"input_epoch\":1}}",
      "expect": {"ok": true, "type": "input.enabled", "session": "7f1a5c8e-0000-4000-8000-000000000001", "negotiation": null, "seq": 4}
    },
    {
      "name": "控制端请求暂停输入",
      "direction": "client->server",
      "input": "{\"v\":1,\"type\":\"input.pause\",\"session\":\"7f1a5c8e-0000-4000-8000-000000000001\",\"negotiation\":null,\"seq\":4,\"payload\":{\"input_epoch\":1}}",
      "expect": {"ok": true, "type": "input.pause", "session": "7f1a5c8e-0000-4000-8000-000000000001", "negotiation": null, "seq": 4}
    },
    {
      "name": "被控端已封闭输入代次",
      "direction": "server->client",
      "input": "{\"v\":1,\"type\":\"input.suspended\",\"session\":\"7f1a5c8e-0000-4000-8000-000000000001\",\"negotiation\":null,\"seq\":5,\"payload\":{\"input_epoch\":1}}",
      "expect": {"ok": true, "type": "input.suspended", "session": "7f1a5c8e-0000-4000-8000-000000000001", "negotiation": null, "seq": 5}
    },
    {
      "name": "控制端请求恢复输入",
      "direction": "client->server",
      "input": "{\"v\":1,\"type\":\"input.resume\",\"session\":\"7f1a5c8e-0000-4000-8000-000000000001\",\"negotiation\":null,\"seq\":5,\"payload\":{\"input_epoch\":1}}",
      "expect": {"ok": true, "type": "input.resume", "session": "7f1a5c8e-0000-4000-8000-000000000001", "negotiation": null, "seq": 5}
    },
    {
      "name": "保活请求",
      "direction": "both",
      "input": "{\"v\":1,\"type\":\"ping\",\"session\":\"7f1a5c8e-0000-4000-8000-000000000001\",\"negotiation\":null,\"seq\":8,\"payload\":{\"t\":123456}}",
      "expect": {"ok": true, "type": "ping", "session": "7f1a5c8e-0000-4000-8000-000000000001", "negotiation": null, "seq": 8}
    },
    {
      "name": "保活应答",
      "direction": "both",
      "input": "{\"v\":1,\"type\":\"pong\",\"session\":\"7f1a5c8e-0000-4000-8000-000000000001\",\"negotiation\":null,\"seq\":9,\"payload\":{\"t\":123456}}",
      "expect": {"ok": true, "type": "pong", "session": "7f1a5c8e-0000-4000-8000-000000000001", "negotiation": null, "seq": 9}
    },
    {
      "name": "结束会话",
      "direction": "both",
      "input": "{\"v\":1,\"type\":\"bye\",\"session\":\"7f1a5c8e-0000-4000-8000-000000000001\",\"negotiation\":null,\"seq\":9,\"payload\":{\"reason\":\"user\"}}",
      "expect": {"ok": true, "type": "bye", "session": "7f1a5c8e-0000-4000-8000-000000000001", "negotiation": null, "seq": 9}
    },
    {
      "name": "error 回指序号",
      "direction": "both",
      "input": "{\"v\":1,\"type\":\"error\",\"session\":\"7f1a5c8e-0000-4000-8000-000000000001\",\"negotiation\":null,\"seq\":10,\"payload\":{\"code\":\"permission_denied\",\"in_reply_to_seq\":8}}",
      "expect": {"ok": true, "type": "error", "session": "7f1a5c8e-0000-4000-8000-000000000001", "negotiation": null, "seq": 10}
    },
    {
      "name": "主版本为 2",
      "direction": "both",
      "input": "{\"v\":2,\"type\":\"media.offer\",\"session\":null,\"negotiation\":null,\"seq\":1,\"payload\":{}}",
      "expect": {"ok": false, "code": "unsupported_version"}
    },
    {
      "name": "缺少 seq",
      "direction": "both",
      "input": "{\"v\":1,\"type\":\"ping\",\"session\":null,\"negotiation\":null,\"payload\":{}}",
      "expect": {"ok": false, "code": "malformed_envelope"}
    },
    {
      "name": "seq 小于 1",
      "direction": "both",
      "input": "{\"v\":1,\"type\":\"bye\",\"session\":null,\"negotiation\":null,\"seq\":0,\"payload\":{}}",
      "expect": {"ok": false, "code": "malformed_envelope"}
    },
    {
      "name": "未知消息类型",
      "direction": "both",
      "input": "{\"v\":1,\"type\":\"offer\",\"session\":null,\"negotiation\":null,\"seq\":1,\"payload\":{}}",
      "expect": {"ok": false, "code": "unsupported_type"}
    }
  ]
}
