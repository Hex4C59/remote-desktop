{
  "_comment": "确定性编排器配置。所有路由/分级/门禁决策都来自这里，不由 LLM 自由判断。",

  "panel": {
    "_comment": "L2 跨 vendor 面板。family 是模型家族(vendor)，不是 provider id —— 网关可托管多个家族。成员按实测可用性选定：opencode-go 全部模型返回 403 Model access is disabled，故不入面板。运行时会排除 coder 所属家族，剩余家族须仍满足 quorum 与 minDistinctFamilies。",
    "members": [
      { "model": "deepseek/deepseek-v4-pro", "family": "deepseek" },
      { "model": "qoder/Qwen4-Max-Preview", "family": "qwen" },
      { "model": "hellocode/gpt-6-luna", "family": "openai" }
    ],
    "quorum": 2,
    "minDistinctFamilies": 2,
    "concurrency": 2,
    "timeoutMs": 480000,
    "thinking": "low"
  },

  "risk": {
    "_comment": "确定性风险分级规则。命中 forbidden 一律升级，绝不自动放行。",
    "forbiddenPaths": ["third_party/", ".git/", "build/"],
    "highPaths": [
      "src/platform/",
      "src/transport/",
      "src/session/",
      "src/input/",
      "include/remotedesktop/"
    ],
    "mediumPaths": ["src/capture/", "src/codec/", "src/telemetry/", "specs/", "docs/"],
    "securityPatterns": [
      "encrypt", "decrypt", "auth", "token", "password", "secret",
      "spake2", "hmac", "pbkdf2", "credential", "SendInput", "inject"
    ],
    "mediumLines": 50,
    "highLines": 300
  },

  "limits": {
    "maxRetries": 2,
    "maxL0ConsecutiveFailures": 2,
    "childTimeoutMs": 600000,
    "diffCap": 14000
  },

  "autoCommit": false,
  "specStatusWrite": false,

  "artifacts": {
    "root": ".orchestrator",
    "gitignore": true,
    "exportDir": "test-results/orchestrator-export"
  },

  "stages": {
    "discussion": { "l0": "none", "l1": true, "panel": false, "human": false },
    "spec": { "l0": "specs", "l1": true, "panel": true, "human": true },
    "plan": { "l0": "coverage", "l1": true, "panel": false, "human": true },
    "task": { "l0": "task", "l1": true, "panel": false, "human": false },
    "code": { "l0": "build", "l1": true, "panel": "risk", "human": "risk" }
  }
}
